#!/bin/sh -e
# Validate options, then restart the daemon so it picks them up.

port="$(snapctl get port)"
camera="$(snapctl get camera)"
threshold="$(snapctl get threshold)"

if [ -n "$port" ] && ! expr "$port" : '[0-9][0-9]*$' >/dev/null; then
  echo "port must be a number, got '$port'" >&2; exit 1
fi
if [ -n "$camera" ] && ! expr "$camera" : '[0-9][0-9]*$' >/dev/null; then
  echo "camera must be a number (the N in /dev/videoN), got '$camera'" >&2; exit 1
fi
if [ -n "$threshold" ] && ! expr "$threshold" : '0*\.[0-9]*$' >/dev/null \
   && [ "$threshold" != "1" ] && [ "$threshold" != "0" ]; then
  echo "threshold must be between 0 and 1, got '$threshold'" >&2; exit 1
fi

# The service isn't running yet during install; ignore that case.
snapctl restart edge-vision-core.server 2>/dev/null || true
